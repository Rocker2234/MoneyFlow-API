meta {
  name: Reset PW
  type: http
  seq: 7
}

post {
  url: {{baseurl}}/password/reset/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_access}}
}

body:json {
  {
    "user": "rocker"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    bru.setGlobalEnvVar("jwt_access", data.access);
    console.log("Access token updated successfully!");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
