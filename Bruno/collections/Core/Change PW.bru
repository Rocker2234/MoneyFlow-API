meta {
  name: Change PW
  type: http
  seq: 5
}

post {
  url: {{baseurl}}/password/change/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_access}}
}

body:json {
  {
    "old_password":"1234",
    "new_password":"1235"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    bru.setGlobalEnvVar("jwt_access", data.access);
    console.log("Access token updated successfully!");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
